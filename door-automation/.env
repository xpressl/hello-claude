# Door Automation System - Environment Variables
# Copy from .env.example and fill in your values

# Node Environment
NODE_ENV=development

# PostgreSQL Configuration
POSTGRES_DB=door_automation
POSTGRES_USER=dooradmin
POSTGRES_PASSWORD=doorpass123
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# MinIO Configuration (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=door-automation

# Orchestrator API Configuration
ORCHESTRATOR_PORT=3000

# SMTP Email Configuration (fill these in for email functionality)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OpenAI API (REQUIRED - get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Vendor Tolerance Settings (defaults)
DEFAULT_PRICE_TOLERANCE_PERCENT=2.0
DEFAULT_SIZE_TOLERANCE_INCHES=0.25

# Basic Auth for Dashboard (temporary)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
