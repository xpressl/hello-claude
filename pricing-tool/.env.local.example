# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (for server-side operations like signed URLs)
# WARNING: Keep this secret! Never expose in client-side code.
# Find this in: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# Phase 4: OCR & ASR Pipeline
# ===================================

# OpenAI Configuration (Required for ASR - Whisper API)
# Get your API key from: https://platform.openai.com/api-keys
# Cost: ~$0.006 per minute of audio
OPENAI_API_KEY=sk-...

# Optional: Custom OCR Configuration
# By default, uses Tesseract.js (free, client-side)
# Uncomment to use cloud OCR services (better accuracy, costs apply)

# Google Cloud Vision API (optional)
# GOOGLE_CLOUD_VISION_API_KEY=...
# GOOGLE_CLOUD_PROJECT_ID=...

# AWS Textract (optional)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# ===================================
# Phase 4 Notes
# ===================================
#
# Required Dependencies:
# - tesseract.js: OCR for PDFs and images
# - pdf-parse: PDF text extraction
# - pdfjs-dist: PDF rendering
# - canvas: PDF to image conversion
# - openai: Whisper API for audio transcription
# - fluent-ffmpeg: Audio format conversion
# - sharp: Image preprocessing (optional)
# - fuse.js: Fuzzy text matching
#
# System Requirements:
# - ffmpeg installed on server (for audio conversion)
#   Ubuntu/Debian: sudo apt-get install ffmpeg
#   macOS: brew install ffmpeg
#   Windows: Download from ffmpeg.org
#
# Storage Requirements:
# - Supabase storage bucket: 'quote-uploads'
# - Max file size: 50MB per upload
# - Supported formats:
#   - PDF: .pdf
#   - Images: .jpg, .jpeg, .png, .gif
#   - Audio: .mp3, .m4a, .wav, .webm, .ogg
#   - Spreadsheets: .xlsx, .csv
#
# API Costs Estimation:
# - Tesseract.js OCR: FREE (runs locally)
# - OpenAI Whisper ASR: $0.006/minute (~$0.03 for 5-min audio)
# - Google Vision API: $1.50/1000 images (if enabled)
# - AWS Textract: $1.50/1000 pages (if enabled)
#
# Performance Notes:
# - OCR processing: 5-30 seconds per page (depends on quality)
# - ASR processing: 10-30 seconds per minute of audio
# - Large files may timeout without proper queue system
# - Consider implementing background job queue for production

# ===================================
# Phase 7: PDF Generation & Email
# ===================================

# Quote Token Secret (for generating secure customer view links)
# Generate a random string: openssl rand -hex 32
QUOTE_TOKEN_SECRET=your-secret-key-for-quote-tokens

# Resend Email Service Configuration (recommended)
# Get API key from: https://resend.com/api-keys
# Free tier: 100 emails/day
RESEND_API_KEY=re_...

# Email Configuration
FROM_EMAIL=quotes@company.com
SALES_TEAM_EMAIL=sales@company.com

# Optional: External PDF Generation Service
# For serverless environments, can use external API like:
# - PDFShift: https://www.pdfshift.io/
# - IronPDF: https://www.ironsoftware.com/
# - Puppeteer service: https://www.browserless.io/
PDF_GENERATOR_URL=
PDF_GENERATOR_API_KEY=

# Storage Configuration
# Supabase storage bucket for PDF files
SUPABASE_STORAGE_BUCKET=quote-pdfs

# ===================================
# Phase 7 Notes
# ===================================
#
# Required Dependencies:
# - Already included in package.json for MVP
#
# Optional: For production PDF generation with full formatting
# - puppeteer: advanced HTML-to-PDF with Chromium
# - pdf-lib: lightweight PDF generation
# - @react-pdf/renderer: React component to PDF
#
# Environment Variables:
# - QUOTE_TOKEN_SECRET: Must be set for secure customer links
# - RESEND_API_KEY: Optional but recommended for production email
# - FROM_EMAIL: Sender email for all quote notifications
#
# Supabase Requirements:
# - Storage bucket: quote-pdfs (create in Supabase dashboard)
# - Table: email_queue (for queue management)
# - Table: events (for tracking opens/clicks)
#
# Email Tracking:
# - Set webhook URL in Resend dashboard to: https://yourdomain.com/api/webhooks/resend
# - Tracks: opens, clicks, bounces, complaints
#
# Testing:
# - Use development environment variables for local testing
# - Test email sending without API key will log to console
# - For production, Resend or similar service required
